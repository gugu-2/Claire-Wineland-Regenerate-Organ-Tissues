# ============================================================
# Genomic Research Copilot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to git.
# ============================================================

# Application
APP_NAME=Genomic Research Copilot
APP_VERSION=3.0.0-research
LOG_LEVEL=INFO

# Database (SQLite by default — no setup needed)
DATABASE_URL=sqlite:///./genom.db

# Data directory (relative to backend/)
DATA_DIR=./data

# External API Timeouts (seconds)
ENSEMBL_TIMEOUT=30
NCBI_TIMEOUT=10
REQUEST_TIMEOUT=8

# CORS — comma-separated allowed origins
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Safety Flags (set to "false" to disable for trusted research lab use)
SAFETY_MODE_ENABLED=true
DURC_SCREENING_ENABLED=true
AUDIT_LOG_ENABLED=true
HUMAN_IN_THE_LOOP_REQUIRED=true

# API Cache TTL in days
CLINVAR_CACHE_TTL_DAYS=7
ENSEMBL_CACHE_TTL_DAYS=30
PUBMED_CACHE_TTL_DAYS=7
